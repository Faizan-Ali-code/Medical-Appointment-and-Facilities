# Copy this file to .env and change values as needed (setup.bat does this and adds a random SECRET_KEY).

# development | testing | production
APP_ENV=development

# Set to 1 only while debugging locally: enables the Werkzeug debugger (run.py refuses non-local HOST then).
# FLASK_DEBUG=1

# If DATABASE_URL is not set, a local SQLite file (instance/medical.db) is used.
# No database server is required in that case.

# To use XAMPP / MySQL instead, uncomment this line:
# DATABASE_URL=mysql+mysqlconnector://root:@localhost/medicalappointmentsfinal

# SECRET_KEY signs the session cookies. Production refuses to start without a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Optional: server address for run.py
# HOST=127.0.0.1
# PORT=5000
