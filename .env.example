# Copy this file to .env and change the values as needed (setup.bat does this and adds a random SECRET_KEY).

# Without DATABASE_URL the app keeps its data in a SQLite file (instance/medibook.db); no database server is needed.
# To use MySQL (for example with XAMPP), create an empty database and uncomment this line:
# DATABASE_URL=mysql+mysqlconnector://root:@localhost/medibook

# Optional: address of the server started by run.py
# HOST=127.0.0.1
# PORT=5000
