# Copy this file to .env and change values as needed.

# development | testing | production
APP_ENV=development

# If DATABASE_URL is not set, a local SQLite file (instance/medical.db) is used.
# No database server is required in that case.

# To use XAMPP / MySQL instead, uncomment this line:
# DATABASE_URL=mysql+mysqlconnector://root:@localhost/medicalappointmentsfinal

SECRET_KEY=change-this-secret-key

# Optional: server address for run.py
# HOST=127.0.0.1
# PORT=5000
